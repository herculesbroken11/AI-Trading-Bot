# =============================================================================
# AI Trading Bot — environment template (placeholders only; never commit .env)
# =============================================================================

# --- Trading safety (Phase 2) ---
# paper   = local simulator only; no broker order HTTP
# sandbox = Tastytrade cert API only (no live/production routing in Phase 2)
# live    = BLOCKED in Phase 2
LIVE_TRADING_ENABLED=false
TRADING_MODE=paper
EMERGENCY_HALT=false
TASTYTRADE_ENV=sandbox
MAX_DAILY_LOSS_USD=500

# --- API admin (required before enabling bot/trade endpoints in later checkpoints) ---
API_ADMIN_KEY=change-me-long-random-string

# --- Tastytrade — sandbox (https://api.cert.tastyworks.com) ---
TASTYTRADE_CLIENT_ID=your_sandbox_client_id
TASTYTRADE_CLIENT_SECRET=your_sandbox_client_secret
TASTYTRADE_USERNAME=your_sandbox_username
TASTYTRADE_PASSWORD=your_sandbox_password
TASTYTRADE_REDIRECT_URI=https://localhost
# Optional: paste refresh token from Developer Sandbox "Create Grant"
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_OAUTH_SCOPES=read trade openid

# --- MARKET DATA — Tastytrade PRODUCTION, read-only quotes (https://api.tastyworks.com) ---
# Production is used ONLY for GET /market-data/by-type. Orders stay on sandbox.
# Use a SEPARATE production OAuth app/grant — never reuse sandbox credentials.
# MARKET_DATA_READ_ONLY must be true (startup fails closed otherwise).
# Scopes must be read-only ("read"); "trade" is rejected.
# REST quotes require a funded production account (no delayed quotes over REST).
MARKET_DATA_PROVIDER=tastytrade
MARKET_DATA_ENV=production
MARKET_DATA_READ_ONLY=true
TASTYTRADE_MARKET_DATA_CLIENT_ID=your_production_market_data_client_id
TASTYTRADE_MARKET_DATA_CLIENT_SECRET=your_production_market_data_client_secret
TASTYTRADE_MARKET_DATA_REFRESH_TOKEN=
TASTYTRADE_MARKET_DATA_SCOPES=read
# Diagnostic stale-quote threshold (seconds) for REST snapshots
MARKET_DATA_MAX_QUOTE_AGE_SECONDS=60
# DXLink streaming (wss://*.dxfeed.com via GET /api-quote-tokens). Quotes older
# than this are stale and must never be traded on.
STREAM_MAX_QUOTE_AGE_SECONDS=1.0

# --- Signal Engine v1 (signal only; never places orders) ---
# Optional overrides; unsafe values (e.g. entry < 60, opposing > entry - 20) are rejected.
# SIGNAL_ENTRY_SCORE_THRESHOLD=70
# SIGNAL_OPPOSING_SCORE_MAX=40
# SIGNAL_MIN_SCORE_GAP=20
# SIGNAL_MAX_SPREAD_PCT=0.30
# SIGNAL_MOMENTUM_THRESHOLD_PCT=0.03

# --- Alpha Vantage (optional market data; not used yet) ---
ALPHAVANTAGE_API_KEY=your_alpha_vantage_key

# --- OpenAI ---
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://tradebot:tradebot@localhost:5432/tradebot

# --- Strategy config (non-secret) ---
TRADING_BOT_CONFIG=config.json

# --- Optional dev ---
SQL_ECHO=false
