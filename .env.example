# =============================================================================
# AI Trading Bot — environment template (placeholders only; never commit .env)
# =============================================================================

# --- Trading safety (Phase 2) ---
# paper   = local simulator only; no broker order HTTP
# sandbox = Tastytrade cert API only (no live/production routing in Phase 2)
# live    = BLOCKED in Phase 2
LIVE_TRADING_ENABLED=false
TRADING_MODE=paper
EMERGENCY_HALT=false
TASTYTRADE_ENV=sandbox
MAX_DAILY_LOSS_USD=500

# --- API admin (required before enabling bot/trade endpoints in later checkpoints) ---
API_ADMIN_KEY=change-me-long-random-string

# --- Tastytrade — sandbox (api.cert.tastytrade.com) ---
TASTYTRADE_CLIENT_ID=your_sandbox_client_id
TASTYTRADE_CLIENT_SECRET=your_sandbox_client_secret
TASTYTRADE_USERNAME=your_sandbox_username
TASTYTRADE_PASSWORD=your_sandbox_password
TASTYTRADE_REDIRECT_URI=https://localhost
# Optional: paste refresh token from Developer Sandbox "Create Grant"
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_OAUTH_SCOPES=read trade openid

# --- Alpha Vantage (market data) ---
ALPHAVANTAGE_API_KEY=your_alpha_vantage_key

# --- OpenAI ---
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://tradebot:tradebot@localhost:5432/tradebot

# --- Strategy config (non-secret) ---
TRADING_BOT_CONFIG=config.json

# --- Optional dev ---
SQL_ECHO=false
